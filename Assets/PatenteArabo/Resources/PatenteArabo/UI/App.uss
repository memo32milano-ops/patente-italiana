/* PatenteArabo — UI Toolkit styles. Reference resolution 1920x1080. */
:root {
    -unity-text-generator: advanced;
    font-size: 30px;
    color: rgb(234, 240, 248);
}

.screen { flex-grow: 1; background-color: rgb(12, 20, 33); }
.fill { flex-grow: 1; }
.row { flex-direction: row; align-items: center; }
.row-rtl { flex-direction: row-reverse; align-items: center; }
.col { flex-direction: column; }
.center { align-items: center; justify-content: center; }
.wrap { flex-wrap: wrap; }
.pad { padding: 28px 40px; }

.topbar { height: 116px; padding: 0 34px; background-color: rgb(17, 29, 48); border-bottom-width: 2px; border-bottom-color: rgb(32, 48, 74); }
.topbar-title { font-size: 40px; -unity-font-style: bold; flex-grow: 1; margin: 0 24px; }
.icon-btn { width: 84px; height: 84px; border-radius: 42px; background-color: rgb(30, 45, 70); font-size: 40px; padding: 0; margin: 0; border-width: 0; }

.title { font-size: 64px; -unity-font-style: bold; color: rgb(255, 255, 255); }
.subtitle { font-size: 34px; color: rgb(160, 176, 200); }
.h2 { font-size: 42px; -unity-font-style: bold; color: rgb(255, 255, 255); margin-bottom: 10px; }
.muted { color: rgb(150, 166, 190); }
.small { font-size: 24px; }
.gold { color: rgb(242, 201, 76); }
.green { color: rgb(110, 220, 150); }
.red { color: rgb(255, 130, 140); }
.bold { -unity-font-style: bold; }
.wraptext { white-space: normal; }

.card { background-color: rgb(22, 35, 58); border-radius: 26px; padding: 26px 30px; margin: 12px; border-width: 2px; border-color: rgb(34, 52, 82); }
.card-hl { border-color: rgb(47, 128, 237); }

.btn { height: 104px; border-radius: 22px; border-width: 0; margin: 10px; padding: 0 30px; font-size: 34px; -unity-font-style: bold; color: rgb(255,255,255); background-color: rgb(36, 54, 84); }
.btn:hover { background-color: rgb(46, 68, 104); }
.btn:active { background-color: rgb(28, 42, 66); }
.btn-primary { background-color: rgb(47, 128, 237); }
.btn-primary:hover { background-color: rgb(70, 146, 245); }
.btn-green { background-color: rgb(39, 174, 96); }
.btn-green:hover { background-color: rgb(52, 196, 112); }
.btn-red { background-color: rgb(214, 64, 69); }
.btn-gold { background-color: rgb(212, 160, 23); color: rgb(20, 20, 20); }
.btn-ghost { background-color: rgba(0,0,0,0); border-width: 2px; border-color: rgb(60, 84, 120); }
.btn-small { height: 76px; font-size: 28px; border-radius: 18px; padding: 0 22px; }
.btn:disabled { opacity: 0.45; }

.home-card { width: 540px; height: 380px; border-radius: 34px; padding: 34px; margin: 16px; justify-content: space-between; border-width: 0; }
.home-card-title { font-size: 46px; -unity-font-style: bold; color: white; white-space: normal; }
.home-card-sub { font-size: 27px; color: rgba(255,255,255,0.85); white-space: normal; }
.home-card-icon { font-size: 70px; color: white; }

.chapter-tile { width: 560px; min-height: 150px; margin: 10px; padding: 20px 24px; border-radius: 22px; background-color: rgb(22, 35, 58); border-width: 2px; border-color: rgb(34, 52, 82); }
.chapter-num { width: 70px; height: 70px; border-radius: 35px; background-color: rgb(47, 128, 237); font-size: 30px; -unity-font-style: bold; -unity-text-align: middle-center; color: white; margin: 0 16px; }
.chapter-title { font-size: 28px; -unity-font-style: bold; white-space: normal; flex-shrink: 1; flex-grow: 1; }
.bar { height: 14px; border-radius: 7px; background-color: rgb(40, 58, 88); margin-top: 12px; overflow: hidden; }
.bar-fill { height: 100%; background-color: rgb(39, 174, 96); border-radius: 7px; }

.lang-tile { width: 420px; height: 100px; margin: 8px; border-radius: 18px; background-color: rgb(22, 35, 58); border-width: 2px; border-color: rgb(34, 52, 82); font-size: 34px; color: white; }
.lang-tile-on { border-color: rgb(242, 201, 76); background-color: rgb(40, 52, 30); }

.it-text { font-size: 40px; color: white; white-space: normal; -unity-font-style: bold; }
.tr-text { font-size: 34px; color: rgb(242, 201, 76); white-space: normal; margin-top: 16px; }
.ex-text { font-size: 31px; color: rgb(220, 230, 245); white-space: normal; }
.trap { color: rgb(255, 120, 120); }
.figure { width: 380px; height: 380px; background-color: white; border-radius: 18px; -unity-background-scale-mode: scale-to-fit; margin: 10px; }
.chip { padding: 6px 18px; border-radius: 30px; background-color: rgb(40, 58, 88); margin: 6px; font-size: 24px; }
.chip-red { background-color: rgb(110, 36, 44); }
.word { margin: 0 4px 6px 0; padding: 2px 6px; border-radius: 8px; font-size: 40px; -unity-font-style: bold; color: white; background-color: rgba(0,0,0,0); border-width: 0; }
.word:hover { background-color: rgb(40, 58, 88); }
.word-trap { color: rgb(255, 120, 120); border-bottom-width: 3px; border-bottom-color: rgb(255, 120, 120); }

.vf { width: 300px; height: 120px; font-size: 44px; }
.verdict-ok { background-color: rgb(24, 90, 52); border-color: rgb(39, 174, 96); }
.verdict-ko { background-color: rgb(100, 30, 36); border-color: rgb(214, 64, 69); }

.overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(4, 8, 14, 0.82); align-items: center; justify-content: center; }
.dialog { width: 1200px; max-height: 92%; background-color: rgb(20, 32, 52); border-radius: 30px; padding: 40px; border-width: 2px; border-color: rgb(47, 128, 237); }
.toast { position: absolute; bottom: 60px; align-self: center; background-color: rgba(0,0,0,0.85); padding: 18px 34px; border-radius: 30px; font-size: 30px; color: white; }

/* ---------- Exam: replica of the ministerial QuizPatenti screen ---------- */
.ex-root { flex-grow: 1; background-color: rgb(223, 230, 235); align-items: center; justify-content: center; }
.ex-frame { width: 1440px; height: 1080px; background-color: rgb(223, 230, 235); }
.ex-header { height: 110px; background-color: rgb(255,255,255); flex-direction: row; align-items: center; justify-content: space-between; padding: 0 30px; border-bottom-width: 2px; border-bottom-color: rgb(200, 210, 218); }
.ex-head-left { font-size: 30px; color: rgb(30, 90, 160); -unity-font-style: bold; }
.ex-head-mid { font-size: 40px; color: rgb(40, 110, 190); -unity-font-style: bold; -unity-text-align: middle-center; }
.ex-head-right { font-size: 22px; color: rgb(90, 100, 110); -unity-text-align: middle-right; }
.ex-photo { width: 70px; height: 84px; background-color: rgb(200, 205, 210); margin-left: 20px; }
.ex-groups { flex-direction: row; justify-content: center; margin-top: 18px; }
.ex-group { width: 300px; height: 60px; margin: 0 3px; background-color: white; border-width: 2px; border-color: rgb(43, 140, 196); font-size: 26px; color: rgb(30, 90, 160); -unity-text-align: middle-center; border-radius: 0; padding: 0; }
.ex-group-on { color: rgb(220, 30, 40); -unity-font-style: bold; }
.ex-nums { flex-direction: row; justify-content: center; margin-top: 8px; }
.ex-num { width: 118px; height: 66px; margin: 0 3px; background-color: white; border-width: 2px; border-color: rgb(43, 140, 196); font-size: 32px; color: rgb(30, 90, 160); -unity-text-align: middle-center; border-radius: 0; padding: 0; }
.ex-num-on { color: rgb(220, 30, 40); -unity-font-style: bold; }
.ex-num-answered { background-color: rgb(205, 215, 222); }
.ex-strip { flex-direction: row; justify-content: center; margin-top: 10px; }
.ex-strip-cell { width: 40px; height: 26px; margin: 0 1px; background-color: white; border-width: 1px; border-color: rgb(43, 140, 196); font-size: 16px; color: rgb(30, 90, 160); -unity-text-align: middle-center; }
.ex-strip-on { color: rgb(220, 30, 40); -unity-font-style: bold; }
.ex-strip-answered { background-color: rgb(205, 215, 222); }
.ex-body { flex-direction: row; margin: 14px 28px 0 28px; height: 520px; }
.ex-img { width: 400px; background-color: white; margin-right: 10px; -unity-background-scale-mode: scale-to-fit; }
.ex-right { flex-grow: 1; }
.ex-qhead { flex-direction: row; justify-content: flex-end; align-items: center; background-color: white; height: 74px; padding: 0 16px; }
.ex-qnum-label { font-size: 32px; color: rgb(30, 30, 30); }
.ex-qnum { width: 58px; height: 52px; border-width: 2px; border-color: rgb(43, 140, 196); font-size: 30px; color: rgb(30, 90, 160); -unity-text-align: middle-center; margin-left: 18px; }
.ex-qtext-box { background-color: white; height: 210px; padding: 6px 16px; }
.ex-qtext-inner { flex-grow: 1; border-width: 2px; border-color: rgb(43, 140, 196); padding: 12px 16px; }
.ex-qtext { font-size: 30px; color: rgb(10, 10, 10); white-space: normal; -unity-font-style: bold; }
.ex-tr { font-size: 26px; color: rgb(150, 90, 0); white-space: normal; margin-top: 8px; }
.ex-answers { background-color: white; flex-grow: 1; margin-top: 10px; align-items: center; justify-content: center; }
.ex-vf-row { flex-direction: row; justify-content: center; }
.ex-vf { align-items: center; margin: 0 60px; }
.ex-vf-label { font-size: 26px; color: rgb(30, 30, 30); }
.ex-vf-btn { width: 96px; height: 96px; border-width: 4px; border-color: rgb(30, 70, 150); background-color: white; border-radius: 6px; font-size: 56px; color: rgb(30, 70, 150); -unity-text-align: middle-center; padding: 0; margin-top: 6px; }
.ex-vf-btn-x { background-color: rgb(210, 220, 235); }
.ex-hint { font-size: 22px; color: rgb(220, 30, 40); margin-top: 14px; -unity-text-align: middle-center; }
.ex-footer { flex-direction: row; align-items: flex-end; margin: 14px 28px; height: 200px; }
.ex-timer-box { width: 230px; }
.ex-timer-label { font-size: 18px; color: rgb(30, 30, 30); }
.ex-timer { height: 96px; border-width: 2px; border-color: rgb(43, 140, 196); background-color: white; font-size: 52px; color: rgb(10, 10, 10); -unity-text-align: middle-center; }
.ex-fields { width: 470px; margin-left: 22px; }
.ex-field-label { font-size: 18px; color: rgb(30, 90, 160); -unity-font-style: bold; }
.ex-field { height: 50px; border-width: 2px; border-color: rgb(43, 140, 196); background-color: white; font-size: 28px; color: rgb(30, 30, 90); -unity-font-style: bold; padding-left: 10px; -unity-text-align: middle-left; margin-bottom: 6px; }
.ex-mid { flex-grow: 1; align-items: center; }
.ex-help { width: 200px; height: 46px; background-color: rgb(200, 210, 218); border-width: 1px; border-color: rgb(140, 150, 160); font-size: 22px; color: rgb(30, 30, 30); border-radius: 4px; }
.ex-abil { font-size: 18px; color: rgb(30, 30, 30); -unity-font-style: bold; margin-top: 30px; }
.ex-navs { flex-direction: row; }
.ex-nav { align-items: center; margin-left: 18px; }
.ex-nav-label { width: 150px; height: 56px; background-color: white; border-width: 1px; border-color: rgb(150, 160, 170); font-size: 20px; color: rgb(10, 10, 10); -unity-font-style: bold; white-space: normal; padding: 2px 6px; }
.ex-nav-btn { width: 96px; height: 96px; border-radius: 48px; background-color: rgb(225, 232, 238); border-width: 3px; border-color: rgb(140, 160, 175); font-size: 44px; color: rgb(110, 130, 150); padding: 0; margin-top: 6px; }
.ex-nav-sq { border-radius: 8px; width: 130px; }

.ex-sum-root { flex-grow: 1; background-color: rgb(246, 200, 214); }
.ex-sum-row { flex-direction: row; height: 150px; border-bottom-width: 2px; border-bottom-color: rgb(43, 140, 196); }
.ex-sum-num { width: 120px; font-size: 38px; color: rgb(43, 140, 196); -unity-font-style: bold; -unity-text-align: middle-center; }
.ex-sum-fig { width: 120px; height: 120px; margin: 15px 8px; background-color: white; -unity-background-scale-mode: scale-to-fit; }
.ex-sum-text { flex-grow: 1; flex-shrink: 1; background-color: white; border-left-width: 2px; border-left-color: rgb(43, 140, 196); }
.ex-sum-text-head { font-size: 18px; color: rgb(30, 50, 120); -unity-font-style: bold; background-color: white; border-bottom-width: 2px; border-bottom-color: rgb(43, 140, 196); padding-left: 6px; }
.ex-sum-text-body { font-size: 22px; color: rgb(30, 30, 100); white-space: normal; padding: 8px; -unity-font-style: bold; }
.ex-sum-cell { width: 70px; background-color: white; border-left-width: 2px; border-left-color: rgb(43, 140, 196); align-items: center; }
.ex-sum-cell-head { font-size: 22px; color: rgb(43, 140, 196); -unity-font-style: bold; height: 34px; width: 100%; -unity-text-align: middle-center; border-bottom-width: 2px; border-bottom-color: rgb(43, 140, 196); }
.ex-sum-check { width: 46px; height: 46px; margin-top: 28px; border-width: 2px; border-color: rgb(30, 30, 30); font-size: 34px; color: rgb(10, 10, 10); -unity-text-align: middle-center; background-color: white; padding: 0; border-radius: 4px; }
.ex-sum-btn { width: 300px; height: 56px; background-color: rgb(200, 205, 210); border-width: 1px; border-color: rgb(140, 150, 160); font-size: 22px; color: rgb(60, 60, 60); border-radius: 4px; margin: 0 40px; }
.ex-light-page { flex-grow: 1; background-color: white; padding: 20px 60px; }
.ex-light-title { font-size: 36px; color: rgb(90, 100, 110); -unity-text-align: middle-center; margin: 16px 0; }
.ex-light-box { flex-grow: 1; border-width: 2px; border-color: rgb(160, 170, 180); padding: 16px; }
.ex-light-text { font-size: 24px; color: rgb(20, 20, 20); white-space: normal; margin-bottom: 14px; }
.ex-light-btn { width: 260px; height: 54px; background-color: rgb(200, 205, 210); border-width: 1px; border-color: rgb(140, 150, 160); font-size: 22px; color: rgb(40, 40, 40); border-radius: 4px; margin: 0 6px; }
.ex-tr-light { font-size: 22px; color: rgb(150, 90, 0); white-space: normal; margin-bottom: 14px; }

/* ---------- Drive HUD ---------- */
.hud { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.hud-pill { background-color: rgba(0,0,0,0.55); border-radius: 22px; padding: 10px 26px; color: white; }
.hud-speed { font-size: 70px; -unity-font-style: bold; -unity-text-align: middle-center; }
.drive-panel { position: absolute; left: 60px; right: 60px; bottom: 20px; background-color: rgba(8, 14, 24, 0.94); border-radius: 30px; padding: 26px 34px; }
.unity-text-field__input { color: rgb(20, 20, 20); background-color: rgb(245, 247, 250); font-size: 32px; }
.setting-row { flex-direction: row; align-items: center; min-height: 104px; padding: 16px 24px; margin: 4px 0; border-radius: 20px; background-color: rgb(20, 32, 52); border-width: 0; color: white; }
.setting-row:hover { background-color: rgb(28, 44, 70); }
.switch { width: 104px; height: 58px; border-radius: 29px; background-color: rgb(60, 74, 100); border-width: 0; padding: 0; margin: 0; flex-shrink: 0; }
.switch-knob { position: absolute; top: 6px; left: 6px; width: 46px; height: 46px; border-radius: 23px; background-color: white; transition-duration: 0.15s; }
.switch-on { background-color: rgb(39, 174, 96); }
.switch-on > .switch-knob { left: 52px; }
.seg { min-width: 150px; }

/* ===================== v3 design ===================== */
:root { -unity-font: resource("PatenteArabo/Fonts/Poppins-Medium"); }
.title, .h2, .gcard-title, .home-hello, .stat-big, .lb-score, .lb-rank, .topbar-title, .btn { -unity-font: resource("PatenteArabo/Fonts/Poppins-Bold"); }
.screen { background-color: rgb(9, 14, 28); }
.home-bg { background-color: rgb(9, 14, 28); }

.gcard { margin: 6px; -unity-background-scale-mode: stretch-to-fill; transition-property: scale, rotate, translate; transition-duration: 0.12s; transition-timing-function: ease-out; }
.gcard-down { scale: 0.95 0.95; rotate: -1.2deg; translate: 0 6px; }
.gcard-inner { position: absolute; left: 6%; right: 6%; top: 9%; bottom: 13%; overflow: hidden; }
.gcard-watermark { position: absolute; bottom: -8%; }
.gcard-bubble { width: 124px; height: 124px; border-radius: 34px; background-color: rgba(255, 255, 255, 0.2); border-width: 2px; border-color: rgba(255, 255, 255, 0.45); }
.gcard-title { font-size: 46px; color: white; white-space: normal; text-shadow: 0 3px 6px rgba(0, 0, 0, 0.45); }
.gcard-sub { font-size: 25px; color: rgba(255, 255, 255, 0.92); white-space: normal; margin-top: 4px; text-shadow: 0 2px 4px rgba(0, 0, 0, 0.35); }
.gcard-badge { background-color: rgba(255, 255, 255, 0.92); color: rgb(17, 24, 39); font-size: 24px; -unity-font-style: bold; padding: 4px 16px; border-radius: 18px; }
.gcard-clip { position: absolute; left: 3.4%; right: 3.4%; top: 4.6%; bottom: 7%; overflow: hidden; border-radius: 34px; }
.gcard-shine { position: absolute; top: -20%; width: 34%; height: 140%; left: -50%; rotate: 18deg; }
.gcard-shine-go { left: 130%; transition-property: left; transition-duration: 1.1s; transition-timing-function: ease-in-out; }

.home-head { padding: 22px 40px 10px 40px; flex-shrink: 0; }
.avatar-btn { width: 112px; height: 112px; border-radius: 56px; border-width: 4px; border-color: rgba(255, 255, 255, 0.55); background-color: rgb(30, 41, 59); padding: 0; margin: 0; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.home-hello { font-size: 40px; color: white; }
.lv-chip { background-color: rgb(99, 102, 241); color: white; font-size: 22px; padding: 2px 14px; border-radius: 14px; -unity-font-style: bold; }
.xp-bar { width: 260px; height: 16px; border-radius: 8px; background-color: rgb(30, 41, 59); margin: 0 12px; overflow: hidden; }
.xp-fill { height: 100%; border-radius: 8px; background-color: rgb(252, 211, 77); }
.stat-chip { background-color: rgb(22, 31, 52); border-radius: 22px; padding: 10px 18px; margin: 0 8px; border-width: 2px; border-color: rgb(40, 52, 80); }
.stat-big { font-size: 32px; color: white; }
.stat-small { font-size: 18px; color: rgb(148, 163, 184); }
.glow { border-width: 3px; border-color: rgb(253, 230, 138); }
.exam-banner { margin: 8px 60px; padding: 18px 26px; border-radius: 26px; background-color: rgb(49, 46, 129); border-width: 2px; border-color: rgb(129, 140, 248); }

.avatar-big { width: 200px; height: 200px; border-radius: 100px; border-width: 6px; border-color: rgba(255, 255, 255, 0.55); -unity-background-scale-mode: scale-to-fit; flex-shrink: 0; }
.avatar-pick { width: 120px; height: 120px; border-radius: 60px; margin: 8px; border-width: 4px; border-color: rgba(0, 0, 0, 0); background-color: rgba(0,0,0,0); padding: 0; -unity-background-scale-mode: scale-to-fit; }
.avatar-pick-on { border-color: rgb(252, 211, 77); }

.lb-row { flex-direction: row; align-items: center; padding: 16px 24px; margin: 6px 0; border-radius: 24px; background-color: rgb(22, 31, 52); border-width: 2px; border-color: rgb(40, 52, 80); }
.lb-me { border-color: rgb(99, 102, 241); background-color: rgb(30, 27, 75); }
.lb-top1 { border-color: rgb(252, 211, 77); background-color: rgb(66, 52, 10); }
.lb-top2 { border-color: rgb(203, 213, 225); background-color: rgb(40, 46, 58); }
.lb-top3 { border-color: rgb(217, 119, 6); background-color: rgb(58, 34, 10); }
.lb-rank { width: 80px; font-size: 40px; color: white; -unity-text-align: middle-center; }
.lb-avatar { width: 96px; height: 96px; border-radius: 48px; -unity-background-scale-mode: scale-to-fit; flex-shrink: 0; }
.lb-score { font-size: 36px; color: rgb(252, 211, 77); margin: 0 16px; }

.sign-tile { width: 300px; min-height: 360px; margin: 10px; padding: 14px; border-radius: 24px; background-color: rgb(248, 250, 252); border-width: 0; align-items: center; }
.sign-img { width: 240px; height: 240px; -unity-background-scale-mode: scale-to-fit; margin-bottom: 8px; }
.badge-card { width: 330px; min-height: 300px; margin: 12px; padding: 22px; border-radius: 28px; background-color: rgb(22, 31, 52); align-items: center; border-width: 2px; border-color: rgb(40, 52, 80); }
.badge-on { border-color: rgb(252, 211, 77); background-color: rgb(45, 38, 12); }

/* brand strip: "Patente Italiana · <name in your language>" */
.brand-strip { flex-direction: row; align-items: center; flex-wrap: wrap; flex-shrink: 1; }
.brand-name { font-size: 42px; -unity-font-style: bold; color: #FFFFFF; letter-spacing: 1px; margin-right: 18px; margin-left: 18px; }
.brand-sub { font-size: 26px; color: #FCD34D; -unity-font-style: bold; padding: 6px 18px; border-radius: 30px; background-color: rgba(252, 211, 77, 0.12); border-width: 2px; border-color: rgba(252, 211, 77, 0.45); }
.brand-name { -unity-font: resource("PatenteArabo/Fonts/Poppins-Bold"); }
/* gold profile (Gold add-on / Premium) */
.gold-frame { border-width: 8px; border-color: #FFD24A; background-color: rgb(60, 45, 10); }
/* daily quiz hero */
.daily-hero { flex-direction: row; align-items: center; margin: 10px 60px 6px 60px; padding: 22px 30px; border-radius: 30px; flex-shrink: 0;
  background-color: rgb(120, 53, 15); border-width: 3px; border-color: rgb(252, 211, 77); }
.daily-done { background-color: rgb(20, 83, 45); border-color: rgb(110, 220, 150); }
.quiz-card { margin-top: 10px; }
.check-box { width: 56px; height: 56px; border-radius: 14px; border-width: 3px; border-color: rgb(148, 163, 184); background-color: rgba(0,0,0,0); font-size: 34px; color: white; -unity-font-style: bold; padding: 0; flex-shrink: 0; }
.check-on { background-color: rgb(34, 197, 94); border-color: rgb(34, 197, 94); }

/* Arabic, Persian, Urdu: the device's Arabic font has no bold face here, and synthetic bold inserts
   spacing between glyphs, which breaks the cursive joining (e.g. a final "ي" with its dots under it in mid-word).
   Keep these scripts in the regular weight and use size/colour for emphasis instead. */
.arabic-script, .arabic-script * { -unity-font-style: normal; letter-spacing: 0; word-spacing: 0; }
.arabic-script .it-text, .arabic-script .word { -unity-font-style: bold; }

/* RTL: these rows set flex-direction after .row-rtl, so flip them explicitly */
.row-rtl.setting-row, .row-rtl.lb-row, .row-rtl.brand-strip, .row-rtl.daily-hero, .row-rtl.exam-banner, .row-rtl.stat-chip, .row-rtl.home-head { flex-direction: row-reverse; }

/* phone app: no desktop scrollbars anywhere (touch scrolling stays) */
.unity-scroll-view__vertical-scroller, .unity-scroll-view__horizontal-scroller { display: none; }

/* home head: brand + licence switcher in one row, then two slim status tiles (cards stay visible on the first screen) */
.home-top { flex-direction: row; align-items: center; justify-content: space-between; flex-wrap: wrap; margin: 10px 46px 4px 46px; flex-shrink: 0; }
.home-top .course-row { margin: 0; }
.status-row { flex-direction: row; margin: 6px 40px 4px 40px; flex-shrink: 0; }
.status-tile { flex-direction: row; align-items: center; flex-grow: 1; flex-basis: 0; margin: 0 6px; padding: 12px 20px; border-radius: 22px; border-width: 2px; min-height: 96px; }
.status-ready { background-color: rgb(30, 31, 74); border-color: rgb(79, 70, 229); }
.status-daily { background-color: rgb(74, 38, 12); border-color: rgb(217, 160, 50); }
.status-done { background-color: rgb(16, 58, 34); border-color: rgb(74, 160, 110); }
.status-col { flex-grow: 1; flex-shrink: 1; margin: 0 16px; }
.status-title { font-size: 28px; color: white; -unity-font-style: bold; white-space: normal; }
.status-pct { font-size: 28px; -unity-font-style: bold; margin: 0 12px; flex-shrink: 0; }
.status-sub { font-size: 20px; color: rgb(203, 213, 225); white-space: normal; margin-top: 2px; }
.status-bar { height: 8px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.14); margin-top: 6px; overflow: hidden; }
.status-fill { height: 8px; border-radius: 4px; }
.row-rtl.home-top, .row-rtl.status-row, .row-rtl.status-tile { flex-direction: row-reverse; }

/* opening screen */
.splash { justify-content: center; align-items: center; padding: 0 160px; background-color: rgb(9, 14, 28); }
.splash-logo { width: 220px; height: 220px; border-radius: 52px; -unity-background-scale-mode: scale-and-crop; border-width: 4px; border-color: rgba(252, 211, 77, 0.6); }
.splash-msg { font-size: 40px; color: rgb(252, 211, 77); margin-top: 18px; -unity-font-style: bold; }
.splash-bar { width: 420px; height: 8px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.12); margin-top: 34px; overflow: hidden; }
.splash-fill { height: 8px; width: 0; border-radius: 4px; background-color: rgb(252, 211, 77); }
